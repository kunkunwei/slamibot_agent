[Unit]
Description=D360 704 first-start NTP gate
After=network-online.target time-sync.target docker.service
Wants=network-online.target time-sync.target docker.service
ConditionPathExists=/etc/slamibot/d360-sensor-guard.ini
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=oneshot
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=slamibot
RuntimeDirectoryMode=0755
ReadWritePaths=/var/lib/slamibot /var/log/slamibot /run/slamibot
ExecStart=/usr/bin/python3 /usr/local/lib/slamibot/d360-sensor-guard/d360_sensor_guard.py startup /etc/slamibot/d360-sensor-guard.ini
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
