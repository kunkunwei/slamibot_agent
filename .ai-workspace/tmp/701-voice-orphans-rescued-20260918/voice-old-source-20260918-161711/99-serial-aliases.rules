# STM32 device rule（当前接在 hub 1-2.1 口 .3；旧拓扑曾为 1-2.3.3）
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-2.1.3", SYMLINK+="ttySTM32", MODE:="0777"

# RTK device rule（当前接在 hub 1-2.1 口 .1；旧拓扑曾为 1-2.3.1；115200 NMEA GGA/RMC）
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-2.1.1", SYMLINK+="ttyRTK", MODE:="0777"

# DOG / SBUS（同一 CH340 口；兼容 SLAMIBOT /dev/ttyDOG 与本仓库 ttySBUS）
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-2.4.3", SYMLINK+="ttyDOG ttySBUS", MODE:="0777"

# Gimbal device rule
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="ttyGimbal", MODE:="0666"

# ListenGo 六麦阵列控制串口（唤醒/DOA），工程默认 /dev/lg_speech_serial
# 本机实际走外接 CH340（与六麦 USB 同级口 1-2.4.4.4），不是复合设备里的 ttyACM
# （ACM 口会枚举但无协议数据；勿再把 lg_speech_serial 指到 ttyACM*）
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-2.4.4.4", SYMLINK+="lg_speech_serial", MODE:="0777"
